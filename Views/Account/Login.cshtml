@model sistema_reparacion_telefonos.Controllers.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow border-0 rounded-4">

                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="mb-1">🔧 Iniciar sesión</h3>
                    <p class="mb-0">Sistema de Reparación de Teléfonos</p>
                </div>

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <p class="text-muted">
                            Introduce tus datos para acceder al sistema.
                        </p>
                    </div>

                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label">
                                Correo electrónico
                            </label>

                            <input asp-for="Correo"
                                   class="form-control form-control-lg"
                                   placeholder="correo@ejemplo.com"
                                   autocomplete="username" />

                            <span asp-validation-for="Correo"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Contrasena" class="form-label">
                                Contraseña
                            </label>

                            <input asp-for="Contrasena"
                                   class="form-control form-control-lg"
                                   placeholder="Introduce tu contraseña"
                                   autocomplete="current-password" />

                            <span asp-validation-for="Contrasena"
                                  class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="Recordarme"
                                   class="form-check-input" />

                            <label asp-for="Recordarme"
                                   class="form-check-label">
                                Recordarme
                            </label>
                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100">
                            Iniciar sesión
                        </button>
                    </form>

                    <hr />

                    <div class="text-center">
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="text-decoration-none">
                            Volver al inicio
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>